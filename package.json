{
  "name": "visa-risk-assessment",
  "version": "1.0.0",
  "description": "VISA risk assessment system with 3-layer architecture",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "ts-node-dev --respawn --transpile-only src/backend/server.ts",
    "dev:frontend": "cd src/frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "cd src/frontend && npm run build",
    "start": "node dist/backend/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:reproducibility": "jest tests/reproducibility",
    "test:integration": "jest tests/integration",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:payment-contexts": "psql $DATABASE_URL -f migrations/005_payment_contexts.sql",
    "db:seed": "node scripts/seed.js",
    "db:seed:rule-sets": "npx ts-node scripts/seed-rule-sets.ts",
    "db:seed:prohibited-terms": "npx ts-node scripts/seed-prohibited-terms.ts",
    "db:seed:demo-entitlements": "node scripts/seed-demo-entitlements.js",
    "check:prohibited-words": "node scripts/check-prohibited-words.js",
    "check:env-leak": "node scripts/check-env-leak.js",
    "demo:diagnosis-result": "node scripts/demo-diagnosis-result.js",
    "demo:verify-cases": "node scripts/demo-verify-cases.js",
    "validate:env": "node scripts/validate-production-env.js",
    "validate:production": "node scripts/validate-production-env.js",
    "prepackage": "npm run check:env-leak",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "visa",
    "immigration",
    "risk-assessment",
    "ai",
    "dify"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "express": "^4.18.2",
    "stripe": "^14.14.0",
    "pg": "^8.11.3",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.1",
    "axios": "^1.6.5",
    "zod": "^3.22.4",
    "uuid": "^9.0.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
