# Server Configuration
NODE_ENV=development
PORT=8080
API_BASE_URL=http://localhost:8080/api/v1

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:secret_key@localhost:5432/visa_assessment
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visa_assessment
DB_USER=user
DB_SECRET_KEY=secret_key
DB_SSL=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# E-03: Server-side product_code → price_id (client cannot set amount)
STRIPE_PRICE_ID_BETTER=price_...
STRIPE_PRICE_ID_BEST=price_...
STRIPE_PRICE_ID_SET=price_...
STRIPE_PRICE_ID_OPTION_MATCHING=price_...
# E-04: Connect (optional)
STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_APPLICATION_FEE_PERCENT=10
STRIPE_AFFILIATE_COMMISSION_PERCENT=5
# Referrer 別 Connect アカウント（任意）: STRIPE_CONNECT_ACCOUNT_REFERRER_<REFERRER_ID>=acct_xxx
# 例: STRIPE_CONNECT_ACCOUNT_REFERRER_001=acct_1234567890
# 未設定の referrer_id は STRIPE_CONNECT_ACCOUNT_ID にフォールバック

# Dify API Configuration
DIFY_API_KEY=your-dify-api-key
DIFY_API_ENDPOINT=https://api.dify.ai/v1
DIFY_WORKFLOW_ID=your-workflow-id

# PDF (E-07): 多言語フォント — 本番で JA/ZH を出力する場合は必須（未設定時はPDF生成エラー）
# 日本語フォント例: C:/Windows/Fonts/msgothic.ttc または /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# 中国語フォント例: C:/Windows/Fonts/msyh.ttc または /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# Windows: C:/Windows/Fonts/msgothic.ttc (日本語), C:/Windows/Fonts/msyh.ttc (中国語)
# Linux: /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc (両対応)
# macOS: /System/Library/Fonts/ヒラギノ角ゴシック W3.ttc (日本語)
PDF_FONT_PATH_JA=C:/Windows/Fonts/msgothic.ttc
PDF_FONT_PATH_ZH=C:/Windows/Fonts/msyh.ttc

# Storage (S3/GCS)
STORAGE_TYPE=s3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-northeast-1
S3_BUCKET=visa-assessment-documents

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_SECRET_KEY=your-email-secret-key
EMAIL_FROM=noreply@example.com

# Security
# 本番では ALLOWED_ORIGINS を本番ドメインのみに限定すること（例: https://app.example.com）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Feature Flags
ENABLE_AUDIT_LOGGING=true
ENABLE_OCR_AUTO_DELETE=true
OCR_RETENTION_DAYS=90

# Professional SaaS
PROFESSIONAL_SUBSCRIPTION_PRICE_ID_STANDARD=price_...
PROFESSIONAL_SUBSCRIPTION_PRICE_ID_PREMIUM=price_...
